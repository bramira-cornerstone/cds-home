VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SNAPSHOT_BASE_URL=https://your-site.com/snapshot/relic
STORAGE_BUCKET=relic-images
POLL_INTERVAL_MS=60000

RENDERER_CONCURRENCY=2
RENDERER_RETRY_ATTEMPTS=3
RENDERER_RETRY_DELAY_MS=5000

CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_PUBLIC_URL=https://your-cdn-url.com/images/relics

PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
